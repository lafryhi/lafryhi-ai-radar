# Runtime mode. Production requires production/firestore/vertex.
NODE_ENV=development
DEPLOYMENT_ENV=local
APP_BASE_URL=http://localhost:3000
PERSISTENCE_ADAPTER=local
LOCAL_DATA_PATH=.data/radar.json

# Temporary Phase 1 operator guard. Use a long random value.
OPERATOR_ACCESS_TOKEN=replace-with-a-long-random-secret

# Vertex AI (Application Default Credentials; never put credentials in this file)
AI_ADAPTER=vertex
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Backward compatibility only; GEMINI_PRIMARY_MODEL takes priority.
GEMINI_MODEL=gemini-2.5-flash
VERTEX_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_RETRY_COUNT=2
GEMINI_RETRY_DELAY_MS=500
GEMINI_FALLBACK_ENABLED=true
GEMINI_THINKING_MODE=auto
GEMINI_SHADOW_ENABLED=false
GEMINI_SHADOW_MODEL=

# Local candidate evaluation only. Disabled by default and never used for production output.
GEMINI_EVALUATION_ENABLED=false
GEMINI_EVALUATION_CANDIDATE_MODEL=
GEMINI_EVALUATION_DATASET_PATH=eval/datasets/gemini-migration.json
GEMINI_EVALUATION_OUTPUT_DIR=eval/results
GEMINI_EVALUATION_CONCURRENCY=1
GEMINI_EVALUATION_TIMEOUT_MS=120000
GEMINI_EVALUATION_MAX_CASES=0
GEMINI_EVALUATION_SAMPLE_RATE=1
GEMINI_EVALUATION_SAVE_RAW_OUTPUTS=false
GEMINI_EVALUATION_REDACT_INPUTS=true
GEMINI_EVALUATION_ALLOW_REAL_CALLS=false
GEMINI_EVALUATION_ALLOWED_MODELS=
GEMINI_EVALUATION_CANDIDATE_STAGE=unknown
GEMINI_EVALUATION_PROBE_LOCATIONS=us-central1,global
GEMINI_EVALUATION_PROBE_THINKING=false
GEMINI_EVALUATION_HARD_CASE_LIMIT=1
GEMINI_EVALUATION_MAX_REQUESTS=6
GEMINI_EVALUATION_MAX_ESTIMATED_INPUT_TOKENS=20000
GEMINI_EVALUATION_MAX_ESTIMATED_OUTPUT_TOKENS=5000
GEMINI_EVALUATION_RUN_LABEL=
GEMINI_EVALUATION_PROBE_SAVE_RESPONSE_PREFIX=true
GEMINI_EVALUATION_PROBE_JSON_RETRY=false
# Evaluation example only:
# GEMINI_EVALUATION_CANDIDATE_MODEL=<verified-candidate-id>
# GEMINI_EVALUATION_ALLOWED_MODELS=<verified-candidate-id>
# GEMINI_EVALUATION_CANDIDATE_STAGE=preview

# Optional Firestore database ID; "(default)" is used when omitted.
FIRESTORE_DATABASE_ID=(default)

# Cloud Scheduler job-name suffix checked by the private scheduled route.
RSS_SCHEDULER_JOB_NAME=lafryhi-ai-radar-rss-discovery
# Bind this from Secret Manager in production; also configure the Scheduler header.
RSS_SCHEDULER_SECRET=replace-with-a-separate-long-random-secret

# Paddle Billing. Keep disabled until all sandbox or production values are configured.
BILLING_ENABLED=false
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=test_replace_with_paddle_client_token
PADDLE_API_KEY=pdl_sdbx_apikey_replace
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace
PADDLE_PRO_PRICE_ID=pri_replace
PADDLE_DEFAULT_CHECKOUT_URL=https://your-service.example
