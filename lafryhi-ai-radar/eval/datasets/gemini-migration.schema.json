{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lafryhi.com/schemas/gemini-migration-1.0.json",
  "title": "LAFRYHI AI Radar Gemini Migration Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasetVersion", "name", "description", "cases"],
  "properties": {
    "datasetVersion": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "language", "source", "businessContext", "expectations", "tags"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "category": { "type": "string", "minLength": 1 },
          "language": { "enum": ["en", "fr", "ar"] },
          "smokeTest": { "type": "boolean", "default": false },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url", "publisher", "publishedAt", "content"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" },
              "publisher": { "type": "string", "minLength": 1 },
              "publishedAt": { "type": "string", "format": "date-time" },
              "content": { "type": "string", "minLength": 20 }
            }
          },
          "businessContext": { "type": "object" },
          "expectations": { "type": "object" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
