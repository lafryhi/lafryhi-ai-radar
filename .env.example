# Runtime: local or firestore
PERSISTENCE_ADAPTER=local
LOCAL_DATA_PATH=.data/radar.json

# Temporary Phase 1 operator guard. Use a long random value.
OPERATOR_ACCESS_TOKEN=replace-with-a-long-random-secret

# Vertex AI (Application Default Credentials; never put credentials in this file)
AI_ADAPTER=vertex
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
VERTEX_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=2048
# Phase 4.1 typed validation and lossless recovery. Defaults to disabled when omitted.
AI_RECOVERY_ENABLED=false

# Optional Firestore database ID; "(default)" is used when omitted.
FIRESTORE_DATABASE_ID=(default)

# Cloud Scheduler job-name suffix checked by the private scheduled route.
RSS_SCHEDULER_JOB_NAME=lafryhi-ai-radar-rss-discovery
